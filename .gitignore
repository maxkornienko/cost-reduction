# macOS
.DS_Store
.AppleDouble
.LSOverride

# Картинки вне папок заданий не коммитим.
# Внутри Task*/ – можно: PNG из .puml генерирует и коммитит CI,
# остальное (heatmap, BPMN, PDF-экспорт) кладётся руками как результат задания.
*.png
*.svg
*.eps
*.pdf
!Task*/**/*.png
!Task*/**/*.svg
!Task*/**/*.pdf
out/

# Скачанный локально рендерер (не место в репозитории)
plantuml.jar

# IDE
.idea/
.vscode/
*.iml

# Временные файлы редакторов и офисных программ
*~
*.swp
*.crswap
~$*
.~lock.*#
