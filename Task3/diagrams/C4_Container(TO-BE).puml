@startuml
' Локальная библиотека C4 – без обращения в интернет.
!RELATIVE_INCLUDE = "."
!include ../../C4PlantUML/C4_Container.puml

hide stereotype
SHOW_PERSON_OUTLINE()

title HLD – кассовая зона VitaStore (TO-BE)

Person(cashier, "Сотрудник магазина", "Работает на кассе, подключает оборудование по инструкции")
Person(engineer, "ИТ-инженер", "Работает удалённо")
Person(merch, "Товаровед HQ", "Проверяет сомнительные позиции маппинга")

System_Boundary(store, "Магазин (Edge)") {
    Container(posApp, "POS App", "Тонкий клиент облачной кассы на планшете", "Экран кассы. Считает чек с учётом лояльности. При обрыве связи продаёт за наличные и только начисляет баллы.")
    ContainerDb(buffer, "Локальная БД", "Хранилище на планшете", "Кэш базы товаров и цен; чеки, продажи и возвраты")
    Container(sync, "Sync-компонент", "Служба на планшете", "Раз в сутки обновляет кэш товаров и цен. Когда сеть появляется, отправляет накопленные чеки в облако.")
    Container(hal, "HAL-агент", "Служба на планшете", "Единое API для оборудования. Адаптер под каждую модель терминала и фискального регистратора.")
}

System_Ext(printer, "Фискальный регистратор", "Разные модели")
System_Ext(terminals, "Банковские терминалы", "Сбербанк, Альфа, Ingenico, Verifone")
System_Ext(bank, "Банк-эквайер", "Одобряет или отклоняет оплату картой")
System_Ext(aiModel, "Облачная ИИ-модель", "Внешний провайдер, доступ по API")

System_Boundary(cloud, "Облако (Cloud Backend)") {
    Container(posBackend, "POS Backend", "SaaS – облачная касса", "Серверная часть кассы: справочник для кассы, смены, приём и хранение чеков, отчёты.")
    Container(sf, "Smart Fulfillment", "PaaS", "Логистика Click & Collect и уведомления о поступлении заказа.")
    Container(sap, "SAP ERP", "IaaS – перенос как есть", "Учёт товаров, кадров, финансов; цены; лояльность.")
    Container(promo, "Promo Engine", "PaaS", "Единый движок промоакций.")
    Container(sku, "SKU Matching", "PaaS – наш сервис маппинга", "Сопоставляет товары купленного магазина с эталонной базой с помощью внешней ИИ-модели.")
}

Rel_R(cashier, posApp, "Работает с кассой", "UI")
Rel_R(posApp, buffer, "Без связи: читает цены из кэша, пишет чеки")
Rel_D(sync, buffer, "Обновляет кэш, забирает накопленные чеки")
Rel_U(sync, posBackend, "Кэш товаров и цен – раз в сутки; чеки – когда сеть появилась", "HTTPS")
Rel_D(posApp, hal, "Печать чека, приём оплаты", "Локальное API")
Rel_D(hal, printer, "Печать фискального чека", "Адаптер модели")
Rel_D(hal, terminals, "Оплата картой", "Адаптер модели")
Rel_R(terminals, bank, "Авторизация оплаты")
Rel_U(posApp, posBackend, "Чеки, продажи; база товаров и цен", "HTTPS")


Rel_R(posBackend, sap, "База товаров и цен; лояльность; продажи для товароучёта", "REST")
Rel_D(sf, sap, "Проверка остатков на складе")
Rel_L(promo, sap, "Промоакции")
Rel_L(sap, sku, "Позиции дампа; кандидат + % уверенности")
Rel_U(sku, aiModel, "Запрос сопоставления", "API")
Rel_D(merch, sap, "Вручную сопоставляет позиции, ушедшие на проверку", "Веб-интерфейс")
Rel_D(engineer, cashier, "Ведёт по инструкции при подключении", "Удалённо")
Rel_U(engineer, sf, "Подключает новый магазин")

SHOW_LEGEND()

@enduml
